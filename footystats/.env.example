SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
PUBLIC_SITE_URL=https://app.ballonetwork.com

# Set as a Supabase Edge Function secret (never put in the Flutter client):
#   supabase secrets set OPENAI_API_KEY=sk-...
# OPENAI_API_KEY is used by functions/moderate-content

# Production OAuth redirect (must also be in Supabase Auth → Redirect URLs):
#   com.ballonetwork.app://login-callback
